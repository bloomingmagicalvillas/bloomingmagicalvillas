---
const base = import.meta.env.BASE_URL;
---

<section id="themed-kids-rooms" class="clearfix highlighted indented right-indent">
	<div class="container">
		<div class="inner clearfix">
			<div class="backing">
				<div class="indent">
					<h2>Themed kids bedrooms</h2>
					<p>Let the kids be a part of the magic with Elsa and Anna in our Frozen themed bedroom, or a Storm Trooper in our Star Wars themed bedroom. The rooms are suitable for big kids too!</p>
					<ul class="actions">
						<li><a href={`${base}rooms/`}>View all rooms</a></li>
					</ul>
				</div>
				<div class="flexslider">
					<ul class="slides clearfix">
						<li><img src={`${base}images/villa/frozen-bedroom.jpg`} alt="Frozen themed kids bedroom" /></li>
						<li><img src={`${base}images/villa/star-wars-room.jpg`} alt="Star Wars themed kids bedroom" /></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>