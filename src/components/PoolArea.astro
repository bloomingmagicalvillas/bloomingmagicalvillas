---
const base = import.meta.env.BASE_URL;
---

<section id="pool-showcase" class="clearfix highlighted">
	<div class="container">
		<div class="inner">
			<div class="showcase-gallery clearfix">
				<div class="text">
					<h2>Private pool area</h2>
					<p>Why not spend the day in the sun around our lovely pool, complete with four sun loungers and a six-seat table for outdoor dining. If you really want to relax, turn on the spa, sit back and let the bubbles take over.</p>
				</div>
				<div><figure><a href={`${base}images/villa/pool.jpg`} data-rel="lightcase:pool"><img src={`${base}images/villa/pool.jpg`} alt="Private pool and spa area" /><span>Private pool and spa</span></a></figure></div>
				<div><figure><a href={`${base}images/villa/pool-3.jpg`} data-rel="lightcase:pool"><img src={`${base}images/villa/pool-3.jpg`} alt="Fully refurbished outside pool deck" /><span>Fully refurbished pool deck</span></a></figure></div>
				<div><figure><a href={`${base}images/villa/pool-2.jpg`} data-rel="lightcase:pool"><img src={`${base}images/villa/pool-2.jpg`} alt="Outdoor dining area" /><span>Outdoor dining area</span></a></figure></div>
			</div>
		</div>
	</div>
</section>