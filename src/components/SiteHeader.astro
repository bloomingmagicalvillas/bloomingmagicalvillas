---
const base = import.meta.env.BASE_URL;
---

<div class="top-bar">
	<div class="inner">
		<div class="slogan">Luxury family Orlando accommodation</div>
		<div class="email-contact"><a href="mailto:info@bloomingvillas.com">info@bloomingvillas.com</a></div>
	</div>
</div>
<header id="header-navigation">
	<div class="inner clearfix">
		<div class="group">
			<div class="container social-header">
				<ul class="social-icons">
					<li><a href="https://www.facebook.com/groups/558080261021380" target="_blank" rel="noreferrer" aria-label="Facebook"><span class="fa fa-facebook" aria-hidden="true"></span></a></li>
					<li><a href="https://twitter.com/bloomingvillas" target="_blank" rel="noreferrer" aria-label="Twitter"><span class="fa fa-twitter" aria-hidden="true"></span></a></li>
					<li><a href="https://www.instagram.com/bloomingvillas" target="_blank" rel="noreferrer" aria-label="Instagram"><span class="fa fa-instagram" aria-hidden="true"></span></a></li>
				</ul>
			</div>
			<div class="container logo-header">
				<a class="header-logo" href={base}><img src={`${base}images/logo/light-logo.svg`} alt="Blooming Magical Villas" /></a>
			</div>
			<div class="container toggle-header">
				<button id="primary-nav-toggle" type="button" aria-label="Open navigation"><span class="fa fa-bars" aria-hidden="true"></span></button>
			</div>
			<div class="container primary-navigation-header">
				<div class="primary-navigation-inner">
					<nav id="primary-navigation" aria-label="Primary navigation">
						<a class="header-logo" href={base}><img src={`${base}images/logo/light-logo.svg`} alt="Blooming Magical Villas" /></a>
						<button id="close-navigation" type="button" aria-label="Close navigation"><span class="fa fa-times" aria-hidden="true"></span></button>
						<ul>
							<li class="about"><a href={`${base}about/`}>About</a></li>
							<li class="rooms"><a href={`${base}rooms/`}>Rooms</a></li>
							<li class="logo"><a href={base} class="header-logo navigation"><img src={`${base}images/logo/light-logo.svg`} alt="Blooming Magical Villas" /></a></li>
							<li class="rates"><a href={`${base}rates/`}>Rates</a></li>
							<li class="contact"><a href="#contact">Contact</a></li>
							<li class="book"><a href={`${base}rates/`}>Book now</a></li>
						</ul>
					</nav>
				</div>
			</div>
			<div class="container action-header" id="action-header">
				<a class="header-action" href={`${base}rates/`}>Book now</a>
			</div>
		</div>
	</div>
</header>