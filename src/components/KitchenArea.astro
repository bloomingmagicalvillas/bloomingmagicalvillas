---
const base = import.meta.env.BASE_URL;
---

<section id="kitchen-area" class="clearfix highlighted indented right-indent">
	<div class="container">
		<div class="inner clearfix">
			<div class="backing">
				<div class="indent">
					<h2>Newly refurbished kitchen</h2>
					<p>The kitchen has recently been updated with new granite worktops and new appliances. It includes a large side-by-side American fridge freezer, Whirlpool oven and hob, microwave, waste disposal unit and dishwasher.</p>
				</div>
				<div class="flexslider">
					<ul class="slides clearfix">
						<li><img src={`${base}images/villa/kitchen-3.jpg`} alt="Newly refurbished kitchen with granite worktops" /></li>
						<li><img src={`${base}images/villa/kitchen.jpg`} alt="Kitchen with Whirlpool oven, hob, microwave, waste disposal unit and dishwasher" /></li>
						<li><img src={`${base}images/villa/kitchen-2.jpg`} alt="Kitchen with a large side-by-side American fridge freezer" /></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>